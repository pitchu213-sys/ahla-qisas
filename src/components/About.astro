
---
import { cloudinaryImage } from '../utils/images';

const rexoImage = 'https://res.cloudinary.com/dvmkrs2jb/image/upload/v1778920064/ChatGPT_Image_16_mai_2026_09_26_58_ggbwy3.png';
const rexoSmall = cloudinaryImage(rexoImage, 'w_220,c_limit');
const rexoMedium = cloudinaryImage(rexoImage, 'w_320,c_limit');
const rexoLarge = cloudinaryImage(rexoImage, 'w_400,c_limit');
---

<section class="container about-wrap">
  <div class="about-card">
    <div class="stars" id="stars2"></div>
    <div class="about-inner">
      <img
        src={rexoLarge}
        srcset={`${rexoSmall} 220w, ${rexoMedium} 320w, ${rexoLarge} 400w`}
        sizes="(max-width: 768px) 90vw, 220px"
        alt="ريكسو"
        class="float about-img"
        width="220"
        height="330"
        loading="lazy"
        decoding="async"
      />
      <div class="about-text">
        <h2>❤ تعرف على ريكسو 👋</h2>
        <p>أنا ريكسو! أحب المغامرات واكتشاف قصص جديدة مع أصدقائي.<br>انضم إليّ في رحلات ممتعة نتعلم فيها الكثير ونمرح معاً!</p>
        <div class="chips">
          <button>🎉 أحب التسلية</button>
          <button>🤔 فضولي</button>
          <button>😊 هادئ</button>
          <button>📚 أحب التعلم</button>
        </div>
      </div>
    </div>
  </div>
</section>
