
---
import { cloudinaryImage } from '../utils/images';

const rexoImage = 'https://res.cloudinary.com/dvmkrs2jb/image/upload/v1778920064/ChatGPT_Image_16_mai_2026_09_26_58_ggbwy3.png';
---

<section class="hero">
  <div class="stars" id="stars"></div>
  <div class="container hero-grid">
    <div class="hero-text">
      <span class="badge">❤ مع ريكسو</span>
      <h1>مرحباً بك في عالم<br><span class="gold">أحلى القصص</span></h1>
      <p class="hero-sub">حيث كل قصة مغامرة جديدة!</p>
      <p class="hero-desc">قصص تعليمية وترفيهية ممتعة وآمنة لطفلك تساعد على تنمية الخيال والقيم وتنمية المهارات.</p>
      <a class="cta" href="/stories">🚀 ابدأ المغامرة الآن</a>
    </div>
    <div class="hero-image">
      <div class="glow"></div>
      <img
        src={cloudinaryImage(rexoImage, 'w_640,c_limit')}
        srcset={`${cloudinaryImage(rexoImage, 'w_420,c_limit')} 420w, ${cloudinaryImage(rexoImage, 'w_640,c_limit')} 640w, ${cloudinaryImage(rexoImage, 'w_840,c_limit')} 840w`}
        sizes="(max-width: 768px) 80vw, 420px"
        width="420"
        height="630"
        alt="ريكسو الديناصور"
        class="rexo"
        decoding="async"
        fetchpriority="high"
      />
    </div>
  </div>
  <svg class="wave" viewBox="0 0 1440 80" preserveAspectRatio="none">
    <path d="M0,40 C360,80 1080,0 1440,40 L1440,80 L0,80 Z" fill="#f7f5fb"/>
  </svg>
</section>
