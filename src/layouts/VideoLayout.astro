---
export interface Props {
  title: string;
  description?: string;
  videoId: string;
  date?: string;
  category?: string;
  duration?: string;
  thumbnail?: string;
}

const {
  title,
  description,
  videoId,
  date,
  category,
  duration,
  thumbnail
} = Astro.props;

const seoDescription =
  description ??
  `فيديو تعليمي ممتع للأطفال بعنوان ${title} من عالم ريكسو.`;

const fullTitle = `${title} | أحلى القصص للأطفال`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const thumbnailURL =
  thumbnail ?? `https://img.youtube.com/vi/${videoId}/hqdefault.jpg`;
const absoluteThumbnailURL = new URL(thumbnailURL, Astro.site).href;
const embedURL = `https://www.youtube-nocookie.com/embed/${videoId}`;
const watchURL = `https://www.youtube.com/watch?v=${videoId}`;

function toIsoDuration(value?: string) {
  if (!value) return undefined;
  const parts = value.split(':').map(Number);
  if (parts.some(Number.isNaN)) return undefined;

  if (parts.length === 2) {
    const [minutes, seconds] = parts;
    return `PT${minutes}M${seconds}S`;
  }

  if (parts.length === 3) {
    const [hours, minutes, seconds] = parts;
    return `PT${hours}H${minutes}M${seconds}S`;
  }

  return undefined;
}

const isoDuration = toIsoDuration(duration);

const videoSchema = {
  "@context": "https://schema.org",
  "@type": "VideoObject",
  "name": title,
  "description": seoDescription,
  "thumbnailUrl": [absoluteThumbnailURL],
  "uploadDate": date || undefined,
  "duration": isoDuration,
  "embedUrl": embedURL,
  "contentUrl": watchURL,
  "url": canonicalURL.href,
  "inLanguage": "ar",
  "genre": category ?? "فيديو تعليمي للأطفال",
  "isFamilyFriendly": true,
  "publisher": {
    "@type": "Organization",
    "name": "أحلى القصص للأطفال",
    "url": Astro.site?.href
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "الرئيسية",
      "item": new URL('/', Astro.site).href
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "الفيديوهات",
      "item": new URL('/videos', Astro.site).href
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": title,
      "item": canonicalURL.href
    }
  ]
};
---
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={seoDescription} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="video.other" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={seoDescription} />
    <meta property="og:image" content={absoluteThumbnailURL} />
    <meta property="og:image:alt" content={`صورة فيديو ${title}`} />
    <meta property="og:locale" content="ar_AR" />
    <meta property="og:site_name" content="أحلى القصص للأطفال" />
    <meta property="og:video" content={embedURL} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={seoDescription} />
    <meta name="twitter:image" content={absoluteThumbnailURL} />

    {date && <meta property="video:release_date" content={date} />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script type="application/ld+json" set:html={JSON.stringify(videoSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <style>
      :root {
        --primary: #1a3c5e;
        --accent: #f4a023;
        --soft: #e8f4f8;
        --white: #ffffff;
        --text: #2c2c2c;
        --muted: #6b7280;
        --border: #dce8f0;
      }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body {
        font-family: 'Tajawal', sans-serif;
        background: #f4f8fb;
        color: var(--text);
        direction: rtl;
        line-height: 1.8;
      }

      .hero {
        background: linear-gradient(135deg, #0d2b45 0%, #1a3c5e 50%, #1e5276 100%);
        padding: 60px 20px 50px;
        text-align: center;
        color: white;
      }
      .hero-badge {
        display: inline-block;
        background: rgba(244,160,35,0.2);
        color: var(--accent);
        border: 1px solid rgba(244,160,35,0.4);
        padding: 6px 18px;
        border-radius: 50px;
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 20px;
      }
      .hero h1 {
        font-family: 'Amiri', serif;
        font-size: clamp(26px, 5vw, 42px);
        line-height: 1.5;
        max-width: 750px;
        margin: 0 auto 20px;
      }
      .hero-meta {
        display: flex;
        justify-content: center;
        gap: 24px;
        flex-wrap: wrap;
        font-size: 13px;
        color: rgba(255,255,255,0.65);
      }

      .container {
        max-width: 900px;
        margin: 0 auto;
        padding: 0 20px;
      }

      /* مشغل الفيديو */
      .video-wrapper {
        background: white;
        border-radius: 20px;
        padding: 20px;
        margin: -30px auto 30px;
        box-shadow: 0 8px 32px rgba(26,60,94,0.15);
        position: relative;
        z-index: 2;
      }
      .video-wrapper iframe {
        width: 100%;
        aspect-ratio: 16 / 9;
        border-radius: 12px;
        border: none;
      }

      /* وصف الفيديو */
      .video-description {
        background: white;
        border-radius: 16px;
        padding: 36px 38px;
        margin: 30px 0;
        box-shadow: 0 2px 16px rgba(26,60,94,0.06);
      }
      .video-description h2 {
        font-family: 'Amiri', serif;
        font-size: 26px;
        color: var(--primary);
        margin-bottom: 20px;
        border-bottom: 2px solid var(--soft);
        padding-bottom: 14px;
      }
      .video-description p {
        font-size: 17px;
        margin-bottom: 16px;
      }
      .video-description ul {
        padding-right: 20px;
        margin-bottom: 20px;
      }
      .video-description ul li {
        margin-bottom: 10px;
      }

      /* روابط أسفل الفيديو */
      .video-footer-links {
        text-align: center;
        margin: 20px 0;
      }
      .video-footer-links a {
        display: inline-block;
        background: var(--accent);
        color: white;
        padding: 12px 28px;
        border-radius: 50px;
        font-weight: 700;
        text-decoration: none;
        margin: 5px;
        box-shadow: 0 4px 16px rgba(244,160,35,0.35);
        transition: 0.2s;
      }
      .video-footer-links a:hover {
        transform: translateY(-2px);
      }

      @media (max-width: 600px) {
        .hero { padding: 40px 16px 36px; }
        .video-wrapper { padding: 12px; }
        .video-description { padding: 24px 18px; }
      }
    </style>
  </head>
  <body>
    <header class="hero">
      <div class="hero-badge">🎬 {category || 'فيديو تعليمي'}</div>
      <h1>{title}</h1>
      {description && <p style="color: rgba(255,255,255,0.8); max-width: 600px; margin: 0 auto 20px;">{description}</p>}
      <div class="hero-meta">
        {date && <span>📅 {date}</span>}
        <span>🎥 يوتيوب</span>
      </div>
    </header>

    <main class="container">
      <div class="video-wrapper">
        <iframe
          src={`https://www.youtube-nocookie.com/embed/${videoId}?rel=0&modestbranding=1`}
          title={title}
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        ></iframe>
      </div>

      <article class="video-description">
        <slot />
      </article>

      <div class="video-footer-links">
        <a href="/videos">🎬 جميع الحلقات</a>
        <a href="/">🏠 الرئيسية</a>
      </div>
    </main>
  </body>
</html>