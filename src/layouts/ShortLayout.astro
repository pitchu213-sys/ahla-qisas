---
export interface Props {
  title: string;
  videoId: string;
}

const { title, videoId } = Astro.props;
---
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | شورتس ريكسو</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <style>
      :root {
        --primary: #1a3c5e;
        --accent: #f4a023;
        --soft: #e8f4f8;
        --white: #ffffff;
        --text: #2c2c2c;
        --muted: #6b7280;
      }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body {
        font-family: 'Tajawal', sans-serif;
        background: #f4f8fb;
        color: var(--text);
        direction: rtl;
        line-height: 1.8;
      }

      .hero {
        background: linear-gradient(135deg, #0d2b45 0%, #1a3c5e 50%, #1e5276 100%);
        padding: 40px 20px 30px;
        text-align: center;
        color: white;
      }
      .hero h1 {
        font-family: 'Amiri', serif;
        font-size: clamp(22px, 5vw, 36px);
        line-height: 1.5;
        max-width: 600px;
        margin: 0 auto 16px;
      }

      .container {
        max-width: 500px;
        margin: 0 auto;
        padding: 0 20px;
      }

      /* مشغل الفيديو العمودي */
      .video-wrapper {
        background: white;
        border-radius: 20px;
        padding: 16px;
        margin: -20px auto 30px;
        box-shadow: 0 8px 32px rgba(26,60,94,0.15);
        position: relative;
        z-index: 2;
        max-width: 400px;
      }
      .video-wrapper iframe {
        width: 100%;
        aspect-ratio: 9 / 16;
        border-radius: 12px;
        border: none;
      }

      /* وصف الفيديو */
      .video-description {
        background: white;
        border-radius: 16px;
        padding: 28px 30px;
        margin: 20px 0;
        box-shadow: 0 2px 16px rgba(26,60,94,0.06);
      }
      .video-description h2 {
        font-family: 'Amiri', serif;
        font-size: 24px;
        color: var(--primary);
        margin-bottom: 16px;
        border-bottom: 2px solid var(--soft);
        padding-bottom: 12px;
      }
      .video-description p {
        font-size: 17px;
        margin-bottom: 14px;
      }
      .video-description ul {
        padding-right: 20px;
        margin-bottom: 16px;
      }
      .video-description ul li {
        margin-bottom: 8px;
      }

      /* روابط أسفل الفيديو */
      .video-footer-links {
        text-align: center;
        margin: 20px 0;
      }
      .video-footer-links a {
        display: inline-block;
        background: var(--accent);
        color: white;
        padding: 12px 28px;
        border-radius: 50px;
        font-weight: 700;
        text-decoration: none;
        margin: 5px;
        box-shadow: 0 4px 16px rgba(244,160,35,0.35);
        transition: 0.2s;
      }
      .video-footer-links a:hover {
        transform: translateY(-2px);
      }

      @media (max-width: 500px) {
        .hero { padding: 30px 16px 20px; }
        .video-wrapper { padding: 12px; border-radius: 16px; }
      }
    </style>
  </head>
  <body>
    <header class="hero">
      <h1>🎵 {title}</h1>
    </header>

    <main class="container">
      <div class="video-wrapper">
        <iframe
          src={`https://www.youtube-nocookie.com/embed/${videoId}?rel=0&modestbranding=1`}
          title={title}
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        ></iframe>
      </div>

      <article class="video-description">
        <slot />
      </article>

      <div class="video-footer-links">
        <a href="/shorts">🎵 جميع الشورتس</a>
        <a href="/">🏠 الرئيسية</a>
      </div>
    </main>
  </body>
</html>