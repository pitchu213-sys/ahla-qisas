---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;  // ← جديد: اختياري
}

const { 
  title, 
  description = "قصص تعليمية وترفيهية ممتعة وآمنة لطفلك مع ريكسو الديناصور"  // ← القيمة الافتراضية
} = Astro.props;
---

<!DOCTYPE html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} - أحلى القصص للأطفال</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;700;900&family=Tajawal:wght@400;700;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    
    <!-- فتحة لحقن وسوم إضافية من الصفحات (لن تؤثر على الرئيسية) -->
    <slot name="head" />
  </head>
  <body>
    <slot />
    <script>
      function makeStars(id, count){
        const c = document.getElementById(id); 
        if(!c) return;
        for(let i=0;i<count;i++){
          const s = document.createElement('span');
          s.className = 'star';
          const size = (i%3)+2;
          s.style.cssText = `top:${(i*37)%100}%;left:${(i*53)%100}%;width:${size}px;height:${size}px;animation-delay:${(i%5)*.6}s`;
          c.appendChild(s);
        }
      }
      makeStars('stars',40);
      makeStars('stars2',25);
      makeStars('stars3',15);
    </script>
  </body>
</html>