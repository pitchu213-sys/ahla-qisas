---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const videoFiles = import.meta.glob('../../content/videos/*.md', { eager: true });
const videos = Object.entries(videoFiles).map(([path, mod]) => ({
  slug: path.split('/').pop()?.replace('.md', ''),
  ...mod.frontmatter
}));

const categoryColors = {
  'جسم الإنسان': 'tag-red',
  'الديناصورات': 'tag-green',
  'الفضاء':      'tag-blue',
  'الطبيعة':     'tag-amber',
  'مهارات':      'tag-purple',
};


const pageTitle = 'فيديوهات تعليمية للأطفال | عالم ريكسو';
const pageDescription = 'شاهد فيديوهات عربية تعليمية وممتعة للأطفال مع ريكسو عن جسم الإنسان والديناصورات والعلوم بطريقة مبسطة.';
const canonicalURL = new URL('/videos', Astro.site);
const pageImage = videos[0]?.thumbnail ??
  (videos[0]?.videoId ? `https://img.youtube.com/vi/${videos[0].videoId}/hqdefault.jpg` : '/favicon.svg');
const absoluteImageURL = new URL(pageImage, Astro.site).href;

const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": pageTitle,
  "description": pageDescription,
  "url": canonicalURL.href,
  "inLanguage": "ar",
  "mainEntity": {
    "@type": "ItemList",
    "numberOfItems": videos.length,
    "itemListElement": videos.map((video, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "name": video.title,
      "url": new URL(`/videos/${video.slug}`, Astro.site).href
    }))
  }
};
---
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDescription} />
  <meta name="robots" content="index, follow, max-image-preview:large" />
  <link rel="canonical" href={canonicalURL} />

  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDescription} />
  <meta property="og:image" content={absoluteImageURL} />
  <meta property="og:locale" content="ar_AR" />
  <meta property="og:site_name" content="أحلى القصص للأطفال" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={pageDescription} />
  <meta name="twitter:image" content={absoluteImageURL} />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
  <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;700;900&family=Amiri:wght@400;700&display=swap" rel="stylesheet" />
  <style>
    :root {
      --primary: #1a3c5e;
      --accent:  #f4a023;
      --dark:    #0d2b45;
      --soft:    #e8f4f8;
      --text:    #2c2c2c;
      --muted:   #6b7280;
      --border:  #dce8f0;
      --white:   #ffffff;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Tajawal', sans-serif;
      background: #f4f8fb;
      color: var(--text);
      direction: rtl;
    }

    /* ===== HERO ===== */
    .hero {
      background: linear-gradient(135deg, #0d2b45 0%, #1a3c5e 60%, #1e5276 100%);
      padding: 52px 20px 96px;
      text-align: center;
      position: relative;
      overflow: hidden;
    }
    .hero::before {
      content: '';
      position: absolute;
      top: -80px; left: -80px;
      width: 280px; height: 280px;
      background: rgba(100,160,255,0.07);
      border-radius: 50%;
    }
    .hero::after {
      content: '';
      position: absolute;
      bottom: -60px; right: -40px;
      width: 200px; height: 200px;
      background: rgba(244,160,35,0.07);
      border-radius: 50%;
    }
    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: rgba(244,160,35,0.15);
      color: var(--accent);
      border: 1px solid rgba(244,160,35,0.3);
      padding: 6px 18px;
      border-radius: 50px;
      font-size: 13px;
      font-weight: 700;
      margin-bottom: 16px;
      position: relative;
    }
    .hero h1 {
      font-family: 'Amiri', serif;
      font-size: clamp(22px, 5vw, 36px);
      color: var(--white);
      line-height: 1.4;
      margin-bottom: 10px;
      position: relative;
    }
    .hero h1 span { color: var(--accent); }
    .hero-sub {
      font-size: 14px;
      color: rgba(255,255,255,0.6);
      position: relative;
    }
    .hero-stats {
      display: flex;
      justify-content: center;
      gap: 28px;
      margin-top: 20px;
      position: relative;
    }
    .hstat-num {
      font-size: 22px;
      font-weight: 900;
      color: var(--accent);
      display: block;
      line-height: 1;
    }
    .hstat-lbl {
      font-size: 10px;
      color: rgba(255,255,255,0.5);
      margin-top: 3px;
    }

    /* ===== ABOUT BOX ===== */
    .about-wrap {
      max-width: 860px;
      margin: -60px auto 0;
      padding: 0 20px;
      position: relative;
      z-index: 10;
    }
    .about-box {
      background: linear-gradient(135deg, #1a2a5e 0%, #1a3c5e 100%);
      border-radius: 24px;
      padding: 28px 24px 22px;
      color: var(--white);
      position: relative;
      overflow: hidden;
    }
    .about-box::before {
      content: '';
      position: absolute;
      top: -40px; left: -40px;
      width: 160px; height: 160px;
      background: rgba(100,160,255,0.08);
      border-radius: 50%;
    }
    .about-label {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: rgba(244,160,35,0.15);
      color: var(--accent);
      border: 1px solid rgba(244,160,35,0.25);
      padding: 4px 14px;
      border-radius: 50px;
      font-size: 12px;
      font-weight: 700;
      margin-bottom: 14px;
      position: relative;
    }
    .about-cards {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      margin-bottom: 20px;
      position: relative;
    }
    .ac {
      background: rgba(255,255,255,0.06);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 14px;
      padding: 16px 14px;
    }
    .ac-icon { font-size: 24px; margin-bottom: 8px; display: block; }
    .ac-title { font-size: 13px; font-weight: 900; color: var(--accent); margin-bottom: 4px; }
    .ac-text  { font-size: 11px; color: rgba(255,255,255,0.7); line-height: 1.7; }
    .about-stats {
      background: var(--accent);
      border-radius: 14px;
      padding: 16px 20px;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 8px;
      position: relative;
    }
    .ast { text-align: center; }
    .ast-num {
      font-size: 20px;
      font-weight: 900;
      color: var(--dark);
      display: block;
      line-height: 1;
    }
    .ast-lbl {
      font-size: 10px;
      color: rgba(13,43,69,0.7);
      margin-top: 3px;
      font-weight: 700;
    }

    /* ===== CONTROLS ===== */
    .controls {
      max-width: 860px;
      margin: 24px auto 0;
      padding: 0 20px;
    }
    .search-bar {
      background: var(--white);
      border-radius: 14px;
      padding: 11px 16px;
      display: flex;
      align-items: center;
      gap: 10px;
      box-shadow: 0 2px 12px rgba(26,60,94,0.08);
      margin-bottom: 12px;
    }
    .search-bar input {
      border: none;
      outline: none;
      font-family: 'Tajawal', sans-serif;
      font-size: 14px;
      flex: 1;
      background: transparent;
      color: var(--primary);
    }
    .search-bar input::placeholder { color: #c4c4c4; }
    .filters {
      display: flex;
      gap: 8px;
      overflow-x: auto;
      scrollbar-width: none;
      padding-bottom: 2px;
    }
    .filters::-webkit-scrollbar { display: none; }
    .flt {
      border: 1.5px solid var(--border);
      border-radius: 50px;
      padding: 6px 15px;
      font-family: 'Tajawal', sans-serif;
      font-size: 12px;
      font-weight: 700;
      color: var(--muted);
      background: var(--white);
      cursor: pointer;
      white-space: nowrap;
      flex-shrink: 0;
      transition: all 0.2s;
    }
    .flt:hover  { border-color: var(--primary); color: var(--primary); }
    .flt.active { background: var(--primary); color: var(--white); border-color: var(--primary); }

    /* ===== VIDEOS GRID ===== */
    .vids-section {
      max-width: 860px;
      margin: 24px auto 0;
      padding: 0 20px 40px;
    }
    .sec-title {
      font-size: 17px;
      font-weight: 900;
      color: var(--primary);
      margin-bottom: 16px;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .vids-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
      gap: 18px;
    }

    /* ===== VIDEO CARD ===== */
    .vcard {
      background: var(--white);
      border-radius: 20px;
      overflow: hidden;
      box-shadow: 0 2px 12px rgba(26,60,94,0.07);
      text-decoration: none;
      color: inherit;
      display: flex;
      flex-direction: column;
      transition: transform 0.2s, box-shadow 0.2s;
    }
    .vcard:hover {
      transform: translateY(-4px);
      box-shadow: 0 8px 24px rgba(26,60,94,0.13);
    }
    .vcard-thumb {
      position: relative;
      width: 100%;
      aspect-ratio: 16/9;
      background: var(--dark);
      overflow: hidden;
    }
    .vcard-thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    .vcard-overlay {
      position: absolute;
      inset: 0;
      background: rgba(0,0,0,0.35);
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background 0.2s;
    }
    .vcard:hover .vcard-overlay { background: rgba(0,0,0,0.55); }
    .play-btn {
      width: 52px;
      height: 52px;
      background: var(--accent);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
      color: var(--white);
      box-shadow: 0 4px 14px rgba(0,0,0,0.3);
      transition: transform 0.2s;
    }
    .vcard:hover .play-btn { transform: scale(1.12); }
    .vcard-cat {
      position: absolute;
      top: 10px;
      right: 10px;
      background: rgba(13,43,69,0.85);
      color: var(--accent);
      font-size: 10px;
      font-weight: 700;
      padding: 3px 10px;
      border-radius: 50px;
    }
    .vcard-dur {
      position: absolute;
      bottom: 10px;
      left: 10px;
      background: rgba(0,0,0,0.75);
      color: var(--white);
      font-size: 10px;
      font-weight: 700;
      padding: 3px 8px;
      border-radius: 6px;
    }
    .vcard-body {
      padding: 16px;
      flex: 1;
      display: flex;
      flex-direction: column;
    }
    .vcard-title {
      font-size: 14px;
      font-weight: 900;
      color: var(--primary);
      line-height: 1.5;
      margin-bottom: 8px;
      flex: 1;
    }
    .vcard-desc {
      font-size: 11px;
      color: var(--muted);
      line-height: 1.6;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      margin-bottom: 10px;
    }
    .vcard-foot {
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-top: 1px solid var(--border);
      padding-top: 10px;
    }
    .vcard-meta {
      display: flex;
      gap: 10px;
      font-size: 11px;
      color: #c4c4c4;
    }
    .vcard-watch {
      font-size: 11px;
      font-weight: 700;
      color: var(--accent);
    }

    /* ===== EMPTY ===== */
    .empty {
      text-align: center;
      padding: 60px 20px;
      color: var(--muted);
      grid-column: 1 / -1;
    }
    .empty p { font-size: 16px; margin-top: 12px; }

    /* ===== RESPONSIVE ===== */
    @media (max-width: 600px) {
      .about-cards { grid-template-columns: 1fr; }
      .about-stats { grid-template-columns: repeat(2, 1fr); gap: 12px; }
      .vids-grid   { grid-template-columns: 1fr; }
      .hero { padding: 40px 16px 90px; }
    }
    @media (max-width: 768px) {
      body { padding-bottom: 74px; }
    }
  </style>
</head>
<body>
  <Header />

  <div class="hero">
    <div class="hero-badge">🎬 مكتبة الفيديوهات</div>
    <h1>تعلّم مع <span>ريكسو</span> بالفيديو</h1>
    <p class="hero-sub">فيديوهات تعليمية قصيرة وممتعة للأطفال</p>
    <div class="hero-stats">
      <div class="hstat">
        <span class="hstat-num">{videos.length}</span>
        <div class="hstat-lbl">فيديو</div>
      </div>
      <div class="hstat">
        <span class="hstat-num">3 دق</span>
        <div class="hstat-lbl">متوسط المدة</div>
      </div>
      <div class="hstat">
        <span class="hstat-num">100%</span>
        <div class="hstat-lbl">مجاني</div>
      </div>
    </div>
  </div>

  <div class="about-wrap">
    <div class="about-box">
      <div class="about-label">🎥 لماذا فيديوهات ريكسو؟</div>
      <div class="about-cards">
        <div class="ac">
          <span class="ac-icon">🧠</span>
          <div class="ac-title">علم مبسّط</div>
          <div class="ac-text">كل فيديو يشرح مفهوماً علمياً بطريقة بسيطة تناسب الأطفال من 3 إلى 8 سنوات.</div>
        </div>
        <div class="ac">
          <span class="ac-icon">⚡</span>
          <div class="ac-title">قصير ومركّز</div>
          <div class="ac-text">لا وقت ضائع — كل فيديو بين 1 و5 دقائق يحمل فكرة واحدة واضحة.</div>
        </div>
        <div class="ac">
          <span class="ac-icon">🎨</span>
          <div class="ac-title">رسوم متحركة</div>
          <div class="ac-text">تصميم مرئي جذاب يشجع الطفل على المتابعة والتفاعل بدل الملل.</div>
        </div>
        <div class="ac">
          <span class="ac-icon">🤝</span>
          <div class="ac-title">للمشاهدة معاً</div>
          <div class="ac-text">صُمِّمت لتشاهدها مع طفلك وتناقشها — تعلّم حقيقي لا مجرد تسلية.</div>
        </div>
      </div>
      <div class="about-stats">
        <div class="ast">
          <span class="ast-num">{videos.length}</span>
          <div class="ast-lbl">فيديو تعليمي</div>
        </div>
        <div class="ast">
          <span class="ast-num">3 دق</span>
          <div class="ast-lbl">متوسط المدة</div>
        </div>
        <div class="ast">
          <span class="ast-num">100%</span>
          <div class="ast-lbl">مجاني</div>
        </div>
        <div class="ast">
          <span class="ast-num">عربي</span>
          <div class="ast-lbl">محتوى أصيل</div>
        </div>
      </div>
    </div>
  </div>

  <div class="controls">
    <div class="search-bar">
      <span style="font-size:18px;color:var(--primary)">🔍</span>
      <input type="text" id="searchInput" placeholder="ابحث في الفيديوهات..." />
    </div>
    <div class="filters">
      <button class="flt active" data-cat="all">الكل</button>
      <button class="flt" data-cat="جسم الإنسان">جسم الإنسان</button>
      <button class="flt" data-cat="الديناصورات">الديناصورات</button>
      <button class="flt" data-cat="الفضاء">الفضاء</button>
      <button class="flt" data-cat="الطبيعة">الطبيعة</button>
      <button class="flt" data-cat="مهارات">مهارات</button>
    </div>
  </div>

  <div class="vids-section">
    <div class="sec-title">🎬 جميع الفيديوهات</div>
    <div class="vids-grid" id="videosGrid">
      {videos.length === 0 ? (
        <div class="empty">
          <div style="font-size:48px">🎬</div>
          <p>لا توجد فيديوهات بعد — قريباً!</p>
        </div>
      ) : (
        videos.map(video => {
          const thumb = video.thumbnail
            || `https://img.youtube.com/vi/${video.videoId}/maxresdefault.jpg`;
          return (
            <a
              href={`/videos/${video.slug}`}
              class="vcard"
              data-title={video.title}
              data-cat={video.category || ''}
            >
              <div class="vcard-thumb">
                <div
                  style={`background-image:url('${thumb}');background-size:cover;background-position:center;width:100%;height:100%;`}
                  role="img"
                  aria-label={video.title}
                ></div>
                <div class="vcard-overlay">
                  <div class="play-btn">▶</div>
                </div>
                {video.category && (
                  <span class="vcard-cat">{video.category}</span>
                )}
                {video.duration && (
                  <span class="vcard-dur">{video.duration}</span>
                )}
              </div>
              <div class="vcard-body">
                <div class="vcard-title">{video.title}</div>
                {video.description && (
                  <div class="vcard-desc">{video.description}</div>
                )}
                <div class="vcard-foot">
                  <div class="vcard-meta">
                    {video.date && <span>📅 {video.date}</span>}
                  </div>
                  <span class="vcard-watch">شاهد ←</span>
                </div>
              </div>
            </a>
          );
        })
      )}
    </div>
  </div>

  <Footer />

  <script>
    const searchInput = document.getElementById('searchInput');
    const filterBtns  = document.querySelectorAll('.flt');
    const cards       = document.querySelectorAll('.vcard');

    let activeCat = 'all';
    let searchVal = '';

    function filterCards() {
      cards.forEach(card => {
        const title = (card.dataset.title || '').toLowerCase();
        const cat   = card.dataset.cat || '';
        const matchSearch = title.includes(searchVal);
        const matchCat    = activeCat === 'all' || cat === activeCat;
        card.style.display = matchSearch && matchCat ? 'flex' : 'none';
      });
    }

    searchInput?.addEventListener('input', e => {
      searchVal = e.target.value.toLowerCase();
      filterCards();
    });

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        filterBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        activeCat = btn.dataset.cat || 'all';
        filterCards();
      });
    });
  </script>
</body>
</html>