---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const articleFiles = import.meta.glob('../../content/articles/*.mdx', { eager: true });
const articles = Object.entries(articleFiles).map(([path, mod]) => ({
  slug: path.split('/').pop()?.replace('.mdx', ''),
  ...mod.frontmatter
}));


const pageTitle = 'مقالات تربية الأطفال والقراءة والنوم | مكتبة الوالدين';
const pageDescription = 'مقالات عربية عملية للوالدين حول تربية الأطفال، القراءة، النوم، الخيال وتنظيم وقت الشاشات.';
const canonicalURL = new URL('/articles', Astro.site);
const pageImage = articles.find((article) => article.heroImage)?.heroImage ?? '/favicon.svg';
const absoluteImageURL = new URL(pageImage, Astro.site).href;

const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": pageTitle,
  "description": pageDescription,
  "url": canonicalURL.href,
  "inLanguage": "ar",
  "mainEntity": {
    "@type": "ItemList",
    "numberOfItems": articles.length,
    "itemListElement": articles.map((article, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "name": article.title,
      "url": new URL(`/articles/${article.slug}`, Astro.site).href
    }))
  }
};
---
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDescription} />
  <meta name="robots" content="index, follow, max-image-preview:large" />
  <link rel="canonical" href={canonicalURL} />

  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDescription} />
  <meta property="og:image" content={absoluteImageURL} />
  <meta property="og:locale" content="ar_AR" />
  <meta property="og:site_name" content="أحلى القصص للأطفال" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={pageDescription} />
  <meta name="twitter:image" content={absoluteImageURL} />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
  <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;700;900&family=Amiri:wght@400;700&display=swap" rel="stylesheet" />
  <style>
    :root {
      --primary: #1a3c5e;
      --accent:  #f4a023;
      --dark:    #0d2b45;
      --soft:    #e8f4f8;
      --text:    #2c2c2c;
      --muted:   #6b7280;
      --border:  #dce8f0;
      --white:   #ffffff;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Tajawal', sans-serif; background: #f4f8fb; color: var(--text); direction: rtl; }

    /* ===== HERO ===== */
    .hero {
      background: linear-gradient(135deg, #0d2b45 0%, #1a3c5e 60%, #1e5276 100%);
      padding: 56px 20px 100px;
      text-align: center;
      position: relative;
      overflow: hidden;
    }
    .hero::before {
      content: '';
      position: absolute;
      top: -80px; left: -80px;
      width: 280px; height: 280px;
      background: rgba(100,160,255,0.07);
      border-radius: 50%;
    }
    .hero::after {
      content: '';
      position: absolute;
      bottom: -60px; right: -40px;
      width: 200px; height: 200px;
      background: rgba(244,160,35,0.07);
      border-radius: 50%;
    }
    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: rgba(244,160,35,0.15);
      color: var(--accent);
      border: 1px solid rgba(244,160,35,0.3);
      padding: 6px 18px;
      border-radius: 50px;
      font-size: 13px;
      font-weight: 700;
      margin-bottom: 18px;
      position: relative;
    }
    .hero h1 {
      font-family: 'Amiri', serif;
      font-size: clamp(24px, 5vw, 38px);
      color: var(--white);
      line-height: 1.4;
      position: relative;
      margin-bottom: 10px;
    }
    .hero h1 span { color: var(--accent); }
    .hero-sub {
      font-size: 14px;
      color: rgba(255,255,255,0.6);
      position: relative;
    }

    /* ===== ABOUT BOX ===== */
    .about-wrap {
      max-width: 900px;
      margin: -60px auto 0;
      padding: 0 20px;
      position: relative;
      z-index: 10;
    }
    .about-box {
      background: linear-gradient(135deg, #1a2a5e 0%, #1a3c5e 100%);
      border-radius: 24px;
      padding: 32px 28px 24px;
      color: white;
      overflow: hidden;
      position: relative;
    }
    .about-box::before {
      content: '';
      position: absolute;
      top: -40px; left: -40px;
      width: 160px; height: 160px;
      background: rgba(100,160,255,0.08);
      border-radius: 50%;
    }
    .about-box-label {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: rgba(244,160,35,0.15);
      color: var(--accent);
      border: 1px solid rgba(244,160,35,0.25);
      padding: 4px 14px;
      border-radius: 50px;
      font-size: 12px;
      font-weight: 700;
      margin-bottom: 16px;
      position: relative;
    }
    .about-cards {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 14px;
      margin-bottom: 24px;
      position: relative;
    }
    .about-card {
      background: rgba(255,255,255,0.06);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 16px;
      padding: 18px 16px;
    }
    .about-card-icon { font-size: 28px; margin-bottom: 10px; display: block; }
    .about-card-title {
      font-size: 14px;
      font-weight: 900;
      color: var(--accent);
      margin-bottom: 6px;
    }
    .about-card-text {
      font-size: 12px;
      color: rgba(255,255,255,0.7);
      line-height: 1.7;
    }
    .about-stats {
      background: var(--accent);
      border-radius: 16px;
      padding: 18px 24px;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 8px;
      position: relative;
    }
    .astat { text-align: center; }
    .astat-num {
      font-size: 22px;
      font-weight: 900;
      color: var(--dark);
      display: block;
      line-height: 1;
    }
    .astat-lbl {
      font-size: 10px;
      color: rgba(13,43,69,0.75);
      margin-top: 4px;
      font-weight: 700;
    }

    /* ===== SEARCH + FILTERS ===== */
    .controls {
      max-width: 900px;
      margin: 28px auto 0;
      padding: 0 20px;
    }
    .search-bar {
      background: white;
      border-radius: 14px;
      padding: 12px 16px;
      display: flex;
      align-items: center;
      gap: 10px;
      box-shadow: 0 2px 12px rgba(26,60,94,0.08);
      margin-bottom: 14px;
    }
    .search-bar input {
      border: none;
      outline: none;
      font-family: 'Tajawal', sans-serif;
      font-size: 14px;
      flex: 1;
      background: transparent;
      color: var(--primary);
    }
    .search-bar input::placeholder { color: #c4c4c4; }
    .search-icon { font-size: 18px; color: var(--primary); }
    .filters {
      display: flex;
      gap: 8px;
      overflow-x: auto;
      scrollbar-width: none;
      padding-bottom: 4px;
    }
    .filters::-webkit-scrollbar { display: none; }
    .flt {
      border: 1.5px solid var(--border);
      border-radius: 50px;
      padding: 7px 16px;
      font-family: 'Tajawal', sans-serif;
      font-size: 12px;
      font-weight: 700;
      color: var(--muted);
      background: white;
      cursor: pointer;
      white-space: nowrap;
      flex-shrink: 0;
      transition: all 0.2s;
    }
    .flt:hover { border-color: var(--primary); color: var(--primary); }
    .flt.active { background: var(--primary); color: white; border-color: var(--primary); }

    /* ===== ARTICLES GRID ===== */
    .articles-section {
      max-width: 900px;
      margin: 28px auto 0;
      padding: 0 20px;
    }
    .section-title {
      font-size: 18px;
      font-weight: 900;
      color: var(--primary);
      margin-bottom: 18px;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .articles-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
      gap: 18px;
    }
    .acard {
      background: white;
      border-radius: 20px;
      overflow: hidden;
      box-shadow: 0 2px 12px rgba(26,60,94,0.07);
      text-decoration: none;
      color: inherit;
      transition: transform 0.2s, box-shadow 0.2s;
      display: flex;
      flex-direction: column;
    }
    .acard:hover {
      transform: translateY(-4px);
      box-shadow: 0 8px 24px rgba(26,60,94,0.13);
    }
    .acard-img {
      width: 100%;
      aspect-ratio: 16/9;
      display: block;
      background-color: var(--soft);
    }
    .acard-img-placeholder {
      width: 100%;
      aspect-ratio: 16/9;
      background: linear-gradient(135deg, #e8f4f8, #dce8f0);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 48px;
    }
    .acard-body {
      padding: 16px;
      flex: 1;
      display: flex;
      flex-direction: column;
    }
    .acard-tag {
      display: inline-block;
      font-size: 10px;
      font-weight: 700;
      padding: 3px 10px;
      border-radius: 50px;
      margin-bottom: 8px;
    }
    .tag-blue   { background: #e8f4f8; color: #1a3c5e; }
    .tag-amber  { background: #fff3e0; color: #8A3A00; }
    .tag-green  { background: #e8f5e9; color: #1a5c30; }
    .tag-purple { background: #f3e8ff; color: #6a0dad; }
    .tag-default{ background: #f0f0f0; color: #555; }
    .acard-title {
      font-size: 15px;
      font-weight: 900;
      color: var(--primary);
      line-height: 1.5;
      margin-bottom: 8px;
      flex: 1;
    }
    .acard-desc {
      font-size: 12px;
      color: var(--muted);
      line-height: 1.6;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      margin-bottom: 12px;
    }
    .acard-foot {
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-top: 1px solid var(--border);
      padding-top: 10px;
      margin-top: auto;
    }
    .acard-meta {
      display: flex;
      gap: 10px;
      font-size: 11px;
      color: #c4c4c4;
    }
    .acard-read {
      font-size: 11px;
      font-weight: 700;
      color: var(--primary);
    }

    /* ===== EMPTY ===== */
    .empty {
      text-align: center;
      padding: 60px 20px;
      color: var(--muted);
    }
    .empty p { font-size: 16px; margin-top: 12px; }

    /* ===== RESPONSIVE ===== */
    @media (max-width: 600px) {
      .about-cards { grid-template-columns: 1fr; }
      .about-stats { grid-template-columns: repeat(2, 1fr); gap: 12px; }
      .articles-grid { grid-template-columns: 1fr; }
      .hero { padding: 40px 16px 90px; }
    }

    @media (max-width: 768px) {
      body { padding-bottom: 74px; }
    }
  </style>
</head>
<body>
  <Header />

  <!-- HERO -->
  <div class="hero">
    <div class="hero-badge">📝 مكتبة الوالدين</div>
    <h1>مقالات <span>علمية</span> لكل أم وأب</h1>
    <p class="hero-sub">محتوى مدعوم بالأبحاث — مكتوب بأسلوب عملي وسهل</p>
  </div>

  <!-- ABOUT BOX -->
  <div class="about-wrap">
    <div class="about-box">
      <div class="about-box-label">📚 لماذا هذه المقالات؟</div>
      <div class="about-cards">
        <div class="about-card">
          <span class="about-card-icon">🧠</span>
          <div class="about-card-title">علم + تربية</div>
          <div class="about-card-text">كل مقالة مبنية على أبحاث علمية حقيقية من متخصصين في تطوير الطفل — لا آراء، بل حقائق.</div>
        </div>
        <div class="about-card">
          <span class="about-card-icon">⏱️</span>
          <div class="about-card-title">قراءة في دقائق</div>
          <div class="about-card-text">نعرف أن وقتك ثمين — لذلك كل مقالة مختصرة ومباشرة بدون حشو أو تعقيد.</div>
        </div>
        <div class="about-card">
          <span class="about-card-icon">🎯</span>
          <div class="about-card-title">نصائح قابلة للتطبيق</div>
          <div class="about-card-text">لن تجد نظريات معلّقة — كل مقالة تنتهي بخطوات عملية يمكنك تطبيقها الليلة.</div>
        </div>
        <div class="about-card">
          <span class="about-card-icon">❤️</span>
          <div class="about-card-title">لأن طفلك يستحق</div>
          <div class="about-card-text">الاستثمار الحقيقي في طفلك لا يكلّف مالاً — بل يكلّف معرفة ووقتاً بسيطاً كل يوم.</div>
        </div>
      </div>
      <div class="about-stats">
        <div class="astat">
          <span class="astat-num">10+</span>
          <div class="astat-lbl">مقالة متخصصة</div>
        </div>
        <div class="astat">
          <span class="astat-num">7 دق</span>
          <div class="astat-lbl">متوسط القراءة</div>
        </div>
        <div class="astat">
          <span class="astat-num">100%</span>
          <div class="astat-lbl">محتوى مجاني</div>
        </div>
        <div class="astat">
          <span class="astat-num">علمي</span>
          <div class="astat-lbl">مدعوم بأبحاث</div>
        </div>
      </div>
    </div>
  </div>

  <!-- SEARCH + FILTERS -->
  <div class="controls">
    <div class="search-bar">
      <span class="search-icon">🔍</span>
      <input type="text" id="searchInput" placeholder="ابحث في المقالات..." />
    </div>
    <div class="filters">
      <button class="flt active" data-cat="all">الكل</button>
      <button class="flt" data-cat="تربية رقمية">تربية رقمية</button>
      <button class="flt" data-cat="صحة الطفل">صحة الطفل</button>
      <button class="flt" data-cat="القراءة المبكرة">القراءة المبكرة</button>
      <button class="flt" data-cat="مهارات حياتية">مهارات حياتية</button>
    </div>
  </div>

  <!-- ARTICLES -->
  <div class="articles-section">
    <div class="section-title">📚 جميع المقالات</div>

    {articles.length === 0 ? (
      <div class="empty">
        <div style="font-size:48px">📝</div>
        <p>لا توجد مقالات بعد — قريباً!</p>
      </div>
    ) : (
      <div class="articles-grid" id="articlesGrid">
        {articles.map(article => {
          const tagColors = {
            'تربية رقمية': 'tag-blue',
            'صحة الطفل':   'tag-green',
            'القراءة المبكرة': 'tag-amber',
            'مهارات حياتية': 'tag-purple',
          };
          const tagClass = tagColors[article.category] || 'tag-default';
          return (
            <a
              href={`/articles/${article.slug}`}
              class="acard"
              data-title={article.title}
              data-cat={article.category || ''}
            >
              {article.heroImage ? (
  <div
    class="acard-img"
    style={`background-image: url('${article.heroImage}'); background-size: cover; background-position: center; aspect-ratio: 16/9;`}
    role="img"
    aria-label={article.title}
  ></div>
) : (
  <div class="acard-img-placeholder">📝</div>
)}
              <div class="acard-body">
                {article.category && (
                  <span class={`acard-tag ${tagClass}`}>{article.category}</span>
                )}
                <div class="acard-title">{article.title}</div>
                {article.description && (
                  <div class="acard-desc">{article.description}</div>
                )}
                <div class="acard-foot">
                  <div class="acard-meta">
                    {article.date && <span>📅 {article.date}</span>}
                    {article.readTime && <span>⏱ {article.readTime}</span>}
                  </div>
                  <span class="acard-read">اقرأ ←</span>
                </div>
              </div>
            </a>
          );
        })}
      </div>
    )}
  </div>

  <div style="height: 40px;"></div>
  <Footer />

  <script>
    const searchInput = document.getElementById('searchInput');
const filterBtns  = document.querySelectorAll('.flt');
const cards       = document.querySelectorAll('.acard');

    let activeCat = 'all';
    let searchVal = '';

    function filterCards() {
      cards.forEach(card => {
        const title = (card.dataset.title || '').toLowerCase();
        const cat   = card.dataset.cat || '';
        const matchSearch = title.includes(searchVal);
        const matchCat    = activeCat === 'all' || cat === activeCat;
        card.style.display = matchSearch && matchCat ? 'flex' : 'none';
      });
    }

    searchInput?.addEventListener('input', e => {
      searchVal = e.target.value.toLowerCase();
      filterCards();
    });

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        filterBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        activeCat = btn.dataset.cat || 'all';
        filterCards();
      });
    });
  </script>
</body>
</html>