---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const storyFiles = import.meta.glob('../../content/stories/*.md', { eager: true });

const allStories = Object.entries(storyFiles).map(([path, mod]) => {
  const slug = path.split('/').pop()?.replace('.md', '') ?? '';
  const frontmatter = mod.frontmatter ?? {};
  const firstPage = frontmatter.pages?.[0]?.front || frontmatter.heroImage || '';

  const image = firstPage
    ? firstPage.startsWith('http') || firstPage.startsWith('/')
      ? firstPage
      : `/images/stories/${slug}/${firstPage}`
    : '';

  return {
    slug,
    title: frontmatter.title ?? 'قصة أطفال',
    description: frontmatter.description ?? '',
    category: frontmatter.category ?? 'قصص أخرى',
    image
  };
});

const categories = [...new Set(allStories.map((story) => story.category).filter(Boolean))];

const pageTitle = 'قصص أطفال عربية مصورة | مكتبة ريكسو';
const pageDescription = 'اكتشف مكتبة ريكسو للقصص العربية المصورة والتعليمية للأطفال، واختر قصص الديناصورات وجسم الإنسان والمغامرات الممتعة.';
const canonicalURL = new URL('/stories', Astro.site);
const socialImage = new URL('/favicon.svg', Astro.site).href;

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'مكتبة ريكسو للقصص',
  description: pageDescription,
  url: canonicalURL.href,
  inLanguage: 'ar',
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: allStories.length,
    itemListElement: allStories.map((story, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: story.title,
      url: new URL(`/stories/${story.slug}`, Astro.site).href
    }))
  }
};
---
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDescription} />
  <meta name="robots" content="index, follow, max-image-preview:large" />
  <link rel="canonical" href={canonicalURL} />

  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDescription} />
  <meta property="og:image" content={socialImage} />
  <meta property="og:locale" content="ar_AR" />
  <meta property="og:site_name" content="أحلى القصص للأطفال" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={pageDescription} />
  <meta name="twitter:image" content={socialImage} />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
  <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;700;900&family=Lalezar&display=swap" rel="stylesheet" />

  <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />

  <style>
    body {
      margin: 0;
      font-family: 'Tajawal', sans-serif;
      background: linear-gradient(180deg, #1a1a6e, #0d0d40);
      min-height: 100vh;
      color: #fff;
      direction: rtl;
    }

    #stories-banner {
      position: relative;
      background: linear-gradient(135deg, #1a1a6e, #2d1b8e, #1a1a6e);
      padding: 50px 20px 60px;
      text-align: center;
      overflow: hidden;
      margin-bottom: 30px;
    }

    #stories-banner h1 {
      font-family: 'Lalezar', cursive;
      font-size: 2.2rem;
      color: #ffcc00;
      margin: 0 0 10px;
      text-shadow: 0 0 20px rgba(255, 204, 0, 0.5);
    }

    #stories-banner p {
      margin: 0;
      line-height: 1.8;
    }

    @keyframes twinkle {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.3; transform: scale(0.7); }
    }

    .category-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
      gap: 30px;
      padding: 20px 16px;
      max-width: 1100px;
      margin: 0 auto 20px;
    }

    .category-card {
      display: flex;
      flex-direction: column;
      align-items: center;
      background: linear-gradient(145deg, #2a2a72, #1a1a6e);
      border-radius: 15px;
      padding: 20px;
      min-height: 180px;
      justify-content: center;
      text-decoration: none;
      color: #fff;
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .category-card:hover,
    .category-card:focus-visible {
      transform: translateY(-8px);
      box-shadow: 0 15px 30px rgba(0, 0, 0, 0.25);
      outline: 3px solid #ffcc00;
      outline-offset: 3px;
    }

    .category-card .icon {
      font-size: 4rem;
      margin-bottom: 10px;
    }

    .category-card h2 {
      margin: 0;
      font-size: 1.15rem;
    }

    .books-section {
      max-width: 1100px;
      margin: 0 auto;
      padding: 10px 16px 50px;
    }

    .books-heading {
      text-align: center;
      margin: 10px 0 20px;
    }

    .books-heading h2 {
      color: #ffcc00;
      margin: 0 0 6px;
      font-size: 1.8rem;
    }

    .books-heading p {
      margin: 0;
      color: rgba(255, 255, 255, 0.8);
    }

    #booksContainer {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 24px 20px;
      padding: 20px 0;
    }

    .book-cell {
      width: 110px;
      max-width: 110px;
      text-align: center;
      color: white;
    }

    .book-cell[hidden] {
      display: none !important;
    }

    .book {
      width: 110px;
      height: 160px;
      position: relative;
      transform-style: preserve-3d;
      transition: transform 0.6s ease;
      filter: drop-shadow(8px 12px 20px rgba(0, 0, 0, 0.5));
      margin: 0 auto;
      overflow: hidden;
    }

    .book-cell:hover .book {
      transform: rotateY(-25deg);
    }

    .book-front {
      position: absolute;
      inset: 0;
      border-radius: 5px 12px 12px 5px;
      overflow: hidden;
      background: linear-gradient(135deg, #f9a825, #ff7043);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .book-front img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .book-spine {
      position: absolute;
      width: 22px;
      height: 100%;
      left: -11px;
      background: linear-gradient(to right, #8b3a00, #c75000, #a84000);
      transform: rotateY(-90deg) translateZ(14px);
      transform-origin: right center;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .book-spine span {
      writing-mode: vertical-rl;
      color: #fff;
      font-size: 8px;
      transform: rotate(180deg);
    }

    .book-title {
      font-size: 12px;
      margin-top: 8px;
      line-height: 1.4;
      min-height: 34px;
    }

    .book-read-btn {
      display: inline-block;
      background: #f9a825;
      color: #000;
      padding: 5px 11px;
      border-radius: 20px;
      font-size: 10px;
      font-weight: bold;
      text-decoration: none;
      margin-top: 5px;
    }

    .book-read-btn:focus-visible,
    .book-front:focus-visible,
    .back-button:focus-visible {
      outline: 3px solid #fff;
      outline-offset: 3px;
    }

    .back-button {
      display: block;
      width: fit-content;
      margin: 20px auto 0;
      background: #1976d2;
      color: white;
      padding: 10px 25px;
      border-radius: 30px;
      text-decoration: none;
    }

    .back-button[hidden],
    #empty-message[hidden] {
      display: none;
    }

    #empty-message {
      text-align: center;
      width: 100%;
      padding: 40px 10px;
    }
  </style>
</head>
<body>
  <Header />

  <main>
    <header id="stories-banner">
      <div style="position:absolute;top:10%;left:5%;font-size:20px;animation:twinkle 2s infinite;">⭐</div>
      <div style="position:absolute;top:20%;right:8%;font-size:14px;animation:twinkle 2.5s infinite;">✨</div>
      <div aria-hidden="true" style="font-size:50px;margin-bottom:10px;">🦖</div>
      <h1>مكتبة ريكسو للقصص</h1>
      <p>اختر قصتك واستمتع بالقراءة مع ريكسو 📖</p>
    </header>

    <nav id="categories-grid" class="category-grid" aria-label="تصنيفات القصص">
      {categories.map((category) => (
        <a href={`?category=${encodeURIComponent(category)}`} class="category-card" data-category-link={category}>
          <span class="icon" aria-hidden="true">📚</span>
          <h2>{category}</h2>
        </a>
      ))}
    </nav>

    <section class="books-section" aria-labelledby="books-heading">
      <div class="books-heading">
        <h2 id="books-heading">جميع القصص</h2>
        <p id="books-count">{allStories.length} قصة متاحة</p>
      </div>

      <div id="booksContainer">
        {allStories.map((story) => (
          <article class="book-cell" data-category={story.category}>
            <div class="book">
              <div class="book-spine" aria-hidden="true"><span>{story.title}</span></div>
              <a href={`/stories/${story.slug}`} class="book-front" aria-label={`اقرأ قصة ${story.title}`}>
                {story.image
                  ? <img src={story.image} alt={`غلاف قصة ${story.title}`} loading="lazy" decoding="async" width="110" height="160" />
                  : <span aria-hidden="true">📖</span>}
              </a>
            </div>
            <h3 class="book-title">{story.title}</h3>
            <a href={`/stories/${story.slug}`} class="book-read-btn">اقرأ الآن</a>
          </article>
        ))}
      </div>

      <p id="empty-message" hidden>📚 لا توجد قصص في هذا التصنيف بعد.</p>
      <a href="/stories" id="back-btn" class="back-button" hidden>⬅️ عرض كل المكتبات</a>
    </section>
  </main>

  <Footer />

  <script>
    const categoriesGrid = document.getElementById('categories-grid');
    const categoryLinks = Array.from(document.querySelectorAll('[data-category-link]'));
    const storyCards = Array.from(document.querySelectorAll('.book-cell'));
    const booksHeading = document.getElementById('books-heading');
    const booksCount = document.getElementById('books-count');
    const emptyMessage = document.getElementById('empty-message');
    const backButton = document.getElementById('back-btn');

    function showStories(category = '') {
      let visibleCount = 0;

      storyCards.forEach((card) => {
        const shouldShow = !category || card.dataset.category === category;
        card.hidden = !shouldShow;
        if (shouldShow) visibleCount += 1;
      });

      booksHeading.textContent = category ? `قصص ${category}` : 'جميع القصص';
      booksCount.textContent = `${visibleCount} قصة متاحة`;
      emptyMessage.hidden = visibleCount !== 0;
      backButton.hidden = !category;
      categoriesGrid.style.display = category ? 'none' : 'grid';
    }

    function categoryFromURL() {
      return new URLSearchParams(window.location.search).get('category') || '';
    }

    categoryLinks.forEach((link) => {
      link.addEventListener('click', (event) => {
        event.preventDefault();
        const category = link.dataset.categoryLink || '';
        history.pushState({}, '', `?category=${encodeURIComponent(category)}`);
        showStories(category);
      });
    });

    backButton.addEventListener('click', (event) => {
      event.preventDefault();
      history.pushState({}, '', '/stories');
      showStories();
    });

    window.addEventListener('popstate', () => {
      showStories(categoryFromURL());
    });

    showStories(categoryFromURL());
  </script>
</body>
</html>