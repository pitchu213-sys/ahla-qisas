---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const pageTitle = "سياسة الخصوصية";
const pageDescription = "تعرف على البيانات التي يرسلها ولي الأمر عبر نموذج التواصل وكيف تُستخدم للرد على الرسائل.";
const pageImage = "/images/default-og.jpg";
const teamImage = "/logo-320.webp";
---

<Layout title={pageTitle} description={pageDescription} image={pageImage}>

  <Header />

  <main>
    <!-- Hero: نستخدم تدرج about-card ليكون متناسقاً -->
    <section class="about-card" style="border-radius: 0 0 2rem 2rem; margin-bottom: 2rem; text-align: center; padding: 4rem 1rem;">
      <div class="container">
        <div class="hero-badge">📄 وثيقة رسمية</div>
        <h1 style="font-size: clamp(2rem, 5vw, 3rem); font-weight: 900; color: #fff;">🔒 سياسة الخصوصية</h1>
        <div style="display: flex; justify-content: center; flex-wrap: wrap; gap: 1.5rem; font-size: 0.85rem; opacity: 0.8; color: #fff; margin-top: 1rem;">
          <span>🏠 <a href="/" style="color: var(--gold);">الرئيسية</a></span>
          <span>📅 آخر تحديث: <time datetime="2026-10-05">5 أكتوبر 2026</time></span>
          <span>🦖 أحلى القصص للأطفال — ريكسو</span>
        </div>
      </div>
    </section>

    <div class="container">
      <div style="text-align: center;">
        <div class="update-date">📅 آخر تحديث: أكتوبر 2026</div>
      </div>

      <!-- مرحباً بك -->
      <div class="card">
        <h2><span class="icon">👋</span> مرحباً بك</h2>
        <p>نرحب بك في موقع <strong>أحلى القصص للأطفال</strong>. نحن نُولي خصوصيتك أهمية قصوى، وهذه الصفحة تشرح بوضوح كيف نتعامل مع بياناتك عند زيارتك لموقعنا.</p>
        <p>توضح هذه السياسة البيانات التي قد ترسلها عند استخدام الموقع وكيفية استخدامها.</p>
        <div class="highlight">
          🦖 موقعنا موجّه للأطفال وعائلاتهم، ونلتزم بأعلى معايير الحماية والأمان.
        </div>
      </div>

      <!-- المعلومات التي نجمعها -->
      <div class="card">
        <h2><span class="icon">📊</span> المعلومات التي نجمعها</h2>
        <p>لا يتطلب الموقع إنشاء حساب. وقد تُرسل بيانات شخصية إذا استخدم الوالد أو ولي الأمر نموذج التواصل.</p>
        <h3>نموذج التواصل</h3>
        <p>النموذج مخصص للوالدين وأولياء الأمور، ويطلب الاسم والبريد الإلكتروني وموضوع الرسالة ونصها. تُرسل هذه البيانات عبر خدمة Web3Forms إلى فريق الموقع لمعالجة الاستفسار والرد عليه. وقد يعالج مزود الخدمة البيانات وفق إعدادات الخدمة وسياساته. نستخدم الرسالة للرد على طلبك، ولا تكتب فيها بيانات شخصية تخص طفلًا أو معلومات حساسة. للاستفسار عن رسالة أرسلتها أو طلب حذفها، تواصل معنا عبر البريد الإلكتروني الموضح في صفحة التواصل.</p>
        <h3>بيانات الزيارة والخدمات الخارجية</h3>
        <p>قد تتلقى الخدمات الخارجية التي تعرض ملفات الموقع، مثل الخطوط أو الصور، بيانات الاتصال التقنية اللازمة لطلب هذه الملفات. لا يتضمن كود الموقع الحالي أدوات Google Analytics أو Google AdSense؛ سنحدّث هذه السياسة إذا أُضيفت خدمات تحليل أو إعلانات مستقبلًا.</p>
      </div>

      <!-- كيف نستخدم هذه البيانات -->
      <div class="card">
        <h2><span class="icon">🎯</span> كيف نستخدم هذه البيانات</h2>
        <p>نستخدم البيانات المجمعة فقط من أجل:</p>
        <ul style="list-style: disc; padding-right: 20px;">
          <li>تحسين تجربة المستخدم وجودة المحتوى</li>
          <li>الرد على رسائل الوالدين وأولياء الأمور</li>
          <li>تطوير محتوى جديد يلبي احتياجات الأطفال وعائلاتهم</li>
        </ul>
        <div class="highlight">
          ✅ لا نبيع بيانات التواصل. تُستخدم الرسالة لمعالجة طلبك والرد عليه.
        </div>
      </div>

      <!-- ملفات تعريف الارتباط -->
      <div class="card">
        <h2><span class="icon">🍪</span> ملفات تعريف الارتباط (Cookies)</h2>
        <p>لا يتضمن كود الموقع الحالي تكاملًا مع Google Analytics أو Google AdSense. وقد تختلف ملفات تعريف الارتباط بحسب الخدمات الخارجية التي يختار المستخدم تحميل محتواها. يمكنك التحكم بملفات تعريف الارتباط أو حذفها من إعدادات المتصفح.</p>
        <p>إذا أُضيفت أدوات تحليل أو إعلانات مستقبلًا، فسنحدّث هذه السياسة لتوضيح البيانات والخدمات المرتبطة بها.</p>
      </div>

      <!-- حماية خصوصية الأطفال -->
      <div class="card">
        <h2><span class="icon">👶</span> حماية خصوصية الأطفال</h2>
        <p>نحن نأخذ حماية خصوصية الأطفال على محمل الجد:</p>
        <ul style="list-style: disc; padding-right: 20px;">
          <li>لا نجمع أي معلومات شخصية مباشرة من الأطفال دون سن 13 عاماً</li>
          <li>محتوى موقعنا موجّه للاستخدام بإشراف الوالدين أو الأوصياء</li>
          <li>إذا اكتشفنا أننا جمعنا بيانات طفل دون موافقة، سنحذفها فوراً</li>
        </ul>
        <div class="highlight">
          👨‍👩‍👧 نشجع الآباء على مراقبة استخدام أطفالهم للإنترنت والإشراف على تصفحهم للموقع.
        </div>
      </div>

      <!-- روابط المواقع الخارجية -->
      <div class="card">
        <h2><span class="icon">🔗</span> روابط المواقع الخارجية</h2>
        <p>قد يحتوي موقعنا على روابط لمواقع خارجية مثل YouTube أو مواقع تعليمية أخرى. نحن غير مسؤولين عن سياسات الخصوصية الخاصة بهذه المواقع، وننصحك بمراجعة سياساتها بشكل مستقل.</p>
      </div>

      <!-- تحديثات السياسة -->
      <div class="card">
        <h2><span class="icon">🔄</span> تحديثات السياسة</h2>
        <p>قد نقوم بتحديث سياسة الخصوصية هذه من وقت لآخر لتعكس التغييرات في الموقع أو المتطلبات القانونية. سيتم نشر التاريخ الجديد للتحديث في أعلى هذه الصفحة.</p>
        <p>نشجعك على مراجعة هذه الصفحة بشكل دوري للاطلاع على أي تغييرات.</p>
      </div>

      <!-- صندوق التواصل -->
      <div class="contact-box">
        <h3>📬 هل لديك استفسار؟</h3>
        <p>إذا كان لديك أي سؤال حول سياسة الخصوصية، لا تتردد في التواصل معنا عبر صفحة <a href="/contact">تواصل معنا</a> أو عبر البريد الإلكتروني الرسمي للموقع.</p>
      </div>

      <!-- AUTHOR BIO -->
      <div class="author-bio" itemscope itemtype="https://schema.org/Person">
        <img src={teamImage} class="author-img" alt="فريق أحلى القصص للأطفال" itemprop="image" width="80" height="80" loading="lazy" decoding="async">
        <div class="author-info">
          <h3 itemprop="name">فريق أحلى القصص للأطفال</h3>
          <p itemprop="description">متخصصون في إنتاج محتوى عربي تعليمي وترفيهي للأطفال من 2 إلى 10 سنوات. نؤمن أن كل طفل يستحق قصة بلغته الأم مع ريكسو 🦖</p>
          <div class="author-credentials">
            <div style="font-weight:800; color:#4a3000;">🎯 التزامنا بالجودة</div>
            <p style="font-size:12px; margin-top:4px;">نحرص على أن يكون كل محتوى آمن، علمي، وممتع. نعتمد على أبحاث تطوير الطفل في تصميم قصصنا وفيديوهاتنا، ونختبر المواد مع أطفال قبل النشر.</p>
          </div>
          <div style="display:flex; gap:12px; flex-wrap:wrap; margin-top:12px;">
            <a href="https://www.facebook.com/profile.php?id=61576170142028" style="color:var(--primary); font-size:13px;">📘 فيسبوك</a>
            <a href="https://www.tiktok.com/@a7la_al9isas_lelatfel" style="color:var(--primary); font-size:13px;">🎵 تيك توك</a>
            <a href="/about" style="color:var(--primary); font-size:13px;">👋 من نحن</a>
          </div>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
